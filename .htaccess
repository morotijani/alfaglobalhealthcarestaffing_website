<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /staffing/
  
  # Serve the actual file if it exists
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  
  # Otherwise route everything to index.html for SPA History API
  RewriteRule . /staffing/index.html [L]
</IfModule>
